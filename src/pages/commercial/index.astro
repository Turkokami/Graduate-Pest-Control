---
import { getEntry } from 'astro:content';
import HubPage from '../../components/HubPage.astro';
const entry = await getEntry('hubs', 'commercial');
if (!entry) throw new Error('[hub] src/content/hubs/commercial.md is missing — Part 3.1: the hub is built before the spokes.');
---
<HubPage entry={entry} path="/commercial/" crumbName="Commercial" />
