---
/**
 * T1 — Home / Hub.
 * Block order: hero value prop + CTA + trust strip -> service entry grid ->
 * why-us -> locations callout -> reviews -> FAQ.
 *
 * Keystone's T1 block order puts a guarantee block between the locations
 * callout and reviews. This site does not have one and never will: Graduate
 * offers no warranty of any kind, by policy. The trust load that block would
 * have carried is spread across the licence numbers, the entomologist on
 * staff, 1983, and the review count.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import AnswerBox from '../components/AnswerBox.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import { getCollection } from 'astro:content';
import { confirmedServices } from '../data/services';
import { business, has } from '../data/business';

const quickAnswer =
  'Graduate Pest Control is a second-generation pest management company serving New York City and Long Island since 1983. ' +
  'We treat every pest problem as a building problem: we find the structural conditions letting pests in, correct them, and seal the entry points, ' +
  'so the infestation stops recurring instead of returning on a schedule.';

const faqs = [
  { question: 'What areas does Graduate Pest Control serve?', answer: 'We serve 44 markets across New York City and Long Island, covering Nassau and Suffolk counties on the North Shore and neighbourhoods across Manhattan, Brooklyn and Queens.' },
  { question: 'What makes Graduate different from other pest control companies?', answer: 'We treat pest work as building science. Most infestations are a symptom of a structural condition — a moisture path, an open sill, an unsealed penetration — and we correct the condition rather than spraying on a schedule.' },
  { question: 'How long has Graduate Pest Control been in business?', answer: `Graduate Pest Control was founded in ${business.foundedYear} by Arnold Katz, who holds a B.S. in Entomology from the University of Georgia. It is now run by his son, Ryan Katz.` },
  { question: 'Do you work with co-op and condo boards?', answer: 'Yes. Building-wide work for boards, property managers and commercial accounts is a core part of the practice, including the documentation those buildings need for their statutory obligations.' },
  { question: 'Do you handle commercial and food facilities?', answer: 'Yes. We work with restaurants, food manufacturing and processing facilities, hotels and property management portfolios, including audit-ready programme documentation.' },
  { question: 'How do I get an inspection scheduled?', answer: `Call ${business.phone} or use the contact form. We will ask what you are seeing and where, because the pattern usually tells us what structural condition to look for first.` },
];

/**
 * The service grid links into /pest-control/{slug}/, and those routes are
 * generated from the `services` CONTENT collection, not from the data file.
 * A confirmed service whose body has not been written yet therefore has no
 * built page, and linking it from the homepage produces a dead link. Filter
 * the grid to services that actually have a page — the entry reappears the
 * moment its content file lands.
 */
const builtServiceSlugs = new Set(
  (await getCollection('services')).map((e) => String(e.data.slug))
);
const services = confirmedServices().filter((s) => builtServiceSlugs.has(s.slug));

/**
 * The same three sets used on /pest-control/, so the homepage and the hub tell
 * the same story about what this firm sells. Splitting the eleven entries into
 * labelled groups is what stops the block reading as one undifferentiated list:
 * the specialist services are the differentiator and were previously buried at
 * the bottom of an alphabetical-ish stack.
 *
 * Anything built but not placed in a set below still appears, under "Also
 * offered", rather than silently vanishing from the homepage.
 */
const SETS: Array<{ label: string; slugs: string[] }> = [
  { label: 'By pest',
    slugs: ['rodent-control', 'ant-control', 'cockroach-control', 'bed-bug-treatment',
            'wasp-hornet-removal', 'wildlife-management', 'mosquito-management'] },
  { label: 'Structural work', slugs: ['structural-exclusion', 'exclusion-consulting'] },
  { label: 'Canine detection', slugs: ['canine-rodent-detection', 'canine-bed-bug-detection'] },
];

const placed = new Set(SETS.flatMap((s) => s.slugs));
const serviceGroups = [
  ...SETS.map((set) => ({
    label: set.label,
    items: set.slugs.map((slug) => services.find((s) => s.slug === slug)).filter(Boolean) as typeof services,
  })),
  { label: 'Also offered', items: services.filter((s) => !placed.has(s.slug)) },
].filter((g) => g.items.length > 0);
---
<BaseLayout
  h1="Pest Control for New York City & Long Island Properties"
  path="/"
  titleCore="NYC & Long Island Pest Control"
  quickAnswer={quickAnswer}
  pageType="home"
  breadcrumbs={[{ name: 'Home', path: '/' }]}
  faqs={faqs}
  areaServed={['New York City', 'Long Island']}
>

  {/* Ryan, August 2026: no slogans or taglines anywhere — where a line like this
      is needed it states credentials that can be checked. His wording, verbatim. */}
  <p class="trust">
    Second-Generation, Family-Owned Since {business.foundedYear} &middot; Entomologist on Staff
  </p>

  <h2>What we handle</h2>
  <div class="svc">
    {serviceGroups.map((g) => (
      <section class="svc-set">
        <h3 class="svc-label">{g.label}</h3>
        <ul class="svc-grid">
          {g.items.map((s) => (
            <li>
              <a href={`/pest-control/${s.slug}/`}>{s.name}</a>
              <span>{s.structuralAngle}</span>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
  <p class="svc-all"><a href="/pest-control/">See all services and how each one is scoped →</a></p>

  <h2>Why a building-science approach</h2>
  <p>{business.position}</p>

  <h2>Where we work</h2>
  <p>
    We serve 44 markets across Long Island and
    New York City. See the full
    <a href="/locations/">service area list</a>.
  </p>

  <Faq faqs={faqs} />
  <Cta />
</BaseLayout>

<style>
  .trust { font-family: var(--font-ui); font-size: 0.9rem; color: var(--ink-soft); }

  /* The service entry grid.
     It was one `display: grid` with no grid-template-columns, so all eleven
     cards stacked in a single column — eleven full-width rows of two-sentence
     copy, which is why the block read as endless. Now it is a responsive
     multi-column grid split into three labelled sets, so the same eleven
     entries scan as three short groups instead of one long list. */
  .svc { margin: 0 0 1.2rem; }
  .svc-set { margin: 0 0 1.5rem; }
  .svc-set:last-child { margin-bottom: 0; }
  .svc-label {
    margin: 0 0 .6rem;
    font-family: var(--font-ui);
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: .11em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  /* auto-fit + minmax: two columns at the text measure, one on a phone, with
     no media query and no fixed count to maintain. */
  .svc-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 10px;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }
  .svc-grid li {
    border: 1px solid var(--line);
    border-left: 3px solid var(--brand);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 12px 14px;
    transition: border-color .15s ease, background-color .15s ease;
  }
  .svc-grid li:hover { border-color: var(--line-strong); background: var(--surface-alt); }
  .svc-grid a {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: var(--t-sm);
    text-decoration: none;
    display: block;
  }
  .svc-grid span {
    display: block;
    font-size: var(--t-xs);
    line-height: 1.45;
    color: var(--ink-soft);
    margin-top: 4px;
  }
  .svc-all { font-family: var(--font-ui); font-size: var(--t-sm); margin: 0 0 1.4rem; }
  .svc-all a { font-weight: 650; text-decoration: none; }
  .svc-all a:hover { text-decoration: underline; }
</style>
