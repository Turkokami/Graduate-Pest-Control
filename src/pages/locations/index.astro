---
/**
 * The geo hub. Part 3.1 cardinal rule: hubs are built with real content BEFORE
 * their children, and audited by inbound-link count rather than by how they look.
 *
 * Markets whose pages are not yet buildable (capacity gate) are listed as plain
 * text, not links — a dead internal link is a gate failure.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Faq from '../../components/Faq.astro';
import Cta from '../../components/Cta.astro';
import GoogleMap from '../../components/GoogleMap.astro';
import { marketsByRegion, effectiveCluster, markets } from '../../data/markets';
import { coverageAltText } from '../../lib/mapdata';
import { googleMyMapId } from '../../data/business';

const li = marketsByRegion('long-island');
const nyc = marketsByRegion('nyc');

/**
 * The hub is the one page where a reader is genuinely comparing places, so it
 * gets the interactive map — pan and zoom earn their place here in a way they
 * never would in a footer. The lists below stay exactly as they were: the map
 * is an addition to the coverage statement, never a replacement for it.
 */
const mapLabel = coverageAltText();

const quickAnswer =
  'Graduate Pest Control serves 44 markets across New York City and Long Island, from the Nassau and Suffolk North Shore ' +
  'through Manhattan, Brooklyn and Queens. Coverage is organized around building type rather than radius, because a pre-war ' +
  'co-op, a brownstone and a waterfront colonial are three genuinely different pest problems requiring different work.';

const faqs = [
  { question: 'Which counties does Graduate Pest Control cover?', answer: 'Nassau and Suffolk counties on Long Island, plus New York, Kings and Queens counties within New York City.' },
  { question: 'Do you charge more for markets further from your base?', answer: 'Pricing is based on the property and the scope of work rather than distance. Call us with the address and we will tell you plainly whether we are the right fit.' },
  { question: 'Can you service a portfolio across several markets?', answer: 'Yes. Portfolio work across multiple buildings and markets is a core part of the commercial practice, with consolidated documentation for compliance purposes.' },
  { question: 'Do you serve neighborhoods not listed here?', answer: 'Often yes — the list below covers the markets we work in most consistently. Call with the address and we will confirm coverage directly.' },
  { question: 'Is the approach different in the city versus Long Island?', answer: 'The principle is the same and the structures are not. City work is dominated by shared walls, risers and chases across a whole building; Long Island work is dominated by the building envelope, crawlspaces and moisture paths of a detached structure.' },
  { question: 'How quickly can you get to a property?', answer: 'It depends on the market and the season. Call us and we will give you a real answer rather than an optimistic one.' },
];
---
<BaseLayout
  h1="Service Areas Across New York City & Long Island"
  path="/locations/"
  titleCore="Service Areas — NYC & Long Island"
  quickAnswer={quickAnswer}
  pageType="page"
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Service Areas', path: '/locations/' }]}
  faqs={faqs}
  areaServed={['New York City', 'Long Island']}
  primaryImage={{
    src: '/img/field/technician-setting-up-pressure-washer-at-truck.webp',
    alt: 'Technician priming a gas-powered sprayer at the tailgate of a company pickup on a New York City street',
    width: 1063,
    height: 1600,
  }}
>

  <GoogleMap
    mid={googleMyMapId}
    heading="Where we work"
    label={mapLabel}
    query="Long Island, New York"
    zoom={9}
    caption={`Long Island and New York City. All ${markets.length} markets are listed as links below — the map is for orientation, the list is what you click.`}
  />

  <h2>Long Island</h2>
  <ul class="areas">
    {li.map((m) => (
      <li>
        {effectiveCluster(m) !== 'area'
          ? <a href={`/locations/${m.slug}/`}>{m.name}</a>
          : <span>{m.name}</span>}
      </li>
    ))}
  </ul>

  <h2>New York City</h2>
  <ul class="areas">
    {nyc.map((m) => (
      <li>
        {effectiveCluster(m) !== 'area'
          ? <a href={`/locations/${m.slug}/`}>{m.name}</a>
          : <span>{m.name}</span>}
      </li>
    ))}
  </ul>

  <Faq faqs={faqs} />
  <Cta />
</BaseLayout>

<style>
  /*
    The market list as tiles rather than a column of underlined text.

    Ryan: "this is very plain… stylized buttons arranged in a symmetrical order,
    shouldn't just be plain text." Two things do the symmetry. `auto-fill` with a
    fixed minimum gives every tile the same width and lays them on a strict grid
    instead of a ragged wrap, and `align-items: stretch` plus a flex tile makes a
    two-word market the same height as a one-word one, so the rows line up even
    where "Cold Spring Harbor" sits beside "Roslyn".
  */
  .areas {
    list-style: none;
    padding: 0;
    margin: 0 0 2.4rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11.5rem, 1fr));
    gap: .6rem;
    align-items: stretch;
  }
  .areas li { display: flex; }

  .areas a,
  .areas span {
    flex: 1;
    display: flex;
    align-items: center;
    min-height: 2.9rem;
    padding: .55rem .85rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    font-family: var(--font-ui);
    font-size: var(--t-sm);
    line-height: 1.25;
    text-decoration: none;
    transition: background-color .12s ease, border-color .12s ease, color .12s ease;
  }

  /* Ryan: the tiles were "still understated — give them some depth, more colour
     and shadow." So they carry a real surface now: a petrol-to-brand gradient,
     a green rule down the left, and a two-part shadow — a soft cast below and a
     tight dark line under the edge, which is what reads as thickness rather
     than as blur. They lift on hover and press back down on click. */
  .areas a {
    color: #fff;
    font-weight: 650;
    background: linear-gradient(160deg, var(--petrol-soft) 0%, var(--brand-deep) 100%);
    border-color: var(--brand-deep);
    border-left: 4px solid var(--green);
    box-shadow:
      0 2px 4px rgba(7, 31, 43, 0.18),
      0 6px 14px rgba(7, 31, 43, 0.12);
    transform: translateY(0);
    transition: transform .12s ease, box-shadow .12s ease, background .12s ease;
  }
  .areas a:hover,
  .areas a:focus-visible {
    background: linear-gradient(160deg, var(--brand) 0%, var(--petrol) 100%);
    border-left-color: var(--green-deep);
    transform: translateY(-2px);
    box-shadow:
      0 4px 8px rgba(7, 31, 43, 0.22),
      0 12px 24px rgba(7, 31, 43, 0.18);
  }
  /* Pressed: back to the resting plane, so a tap feels like a button. */
  .areas a:active {
    transform: translateY(0);
    box-shadow: 0 1px 3px rgba(7, 31, 43, 0.25);
  }
  @media (prefers-reduced-motion: reduce) {
    .areas a { transition: none; }
    .areas a:hover, .areas a:focus-visible { transform: none; }
  }

  /* Markets without a page yet. Deliberately not styled as a button: it is not
     one, and dressing an unclickable tile like a link is the kind of small lie
     this build does not tell. */
  .areas span {
    color: var(--ink-faint);
    background: var(--surface-alt);
    border-style: dashed;
    border-left: 1px dashed var(--line-strong);
    box-shadow: none;
  }
</style>
