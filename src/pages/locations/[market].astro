---
/**
 * T4 — City / market page.
 *
 * Renders the deep markdown body from the `towns` collection. The route only
 * exists for markets whose research is verified (capacity gate) AND which have
 * a content file — Part 7A's data/body split.
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AnswerBox from '../../components/AnswerBox.astro';
import Faq from '../../components/Faq.astro';
import Cta from '../../components/Cta.astro';
import QuickInquiry from '../../components/QuickInquiry.astro';
import GoogleMap from '../../components/GoogleMap.astro';
import { markets, effectiveCluster, type Market , marketLabel} from '../../data/markets';
import { siblingLinks, servicesFor, marketBreadcrumbs, regionLabel } from '../../lib/geo';
import { neighboursOf } from '../../lib/mapdata';
import { business } from '../../data/business';
import { crewSocialImage } from '../../data/social';

export const prerender = true;

export async function getStaticPaths() {
  const entries = await getCollection('towns');
  return entries
    .map((entry) => {
      const market = markets.find((m) => m.slug === entry.data.slug);
      return market && effectiveCluster(market) !== 'area'
        ? { params: { market: String(entry.data.slug) }, props: { entry, market } }
        : null;
    })
    .filter((x): x is NonNullable<typeof x> => x !== null);
}

interface Props { entry: any; market: Market }
const { entry, market } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const siblings = siblingLinks(market.slug);
// Ryan, September 2026: services run in the order he wants to be known for.
// Anything he did not name keeps its existing place below those, which keeps
// wildlife at the foot of the list.
const SERVICE_ORDER = ["structural-exclusion", "rodent-control", "cockroach-control", "ant-control", "wasp-hornet-removal", "bed-bug-treatment"];
const rank = (slug: string) => (SERVICE_ORDER.includes(slug) ? SERVICE_ORDER.indexOf(slug) : SERVICE_ORDER.length);
const services = servicesFor(market).sort((a, b) => rank(a.slug) - rank(b.slug));
const path = `/locations/${market.slug}/`;

/**
 * Town-by-service pages that exist for this market. The services list below
 * linked every service to its general page, while the body copy linked the
 * town version, so the same page pointed two ways and the town pages were
 * reachable only from inside the prose. Where a town version exists the list
 * now points at it; the gate crawler checks every one of these links.
 */
const cityPages = new Set(
  (await getCollection('matrix'))
    .filter((e) => e.data.city === market.slug)
    .map((e) => String(e.data.service))
);

/**
 * The town map draws the whole service area with this market singled out and
 * its own region emphasized, so a reader sees where the place actually sits
 * rather than a rectangle of street grid around it. The nearest markets are
 * named in the caption, which is the same information the "Nearby areas we
 * serve" list carries below — the list stays, because the map is not a
 * substitute for it.
 */
const near = neighboursOf(market.slug, 4).map((p) => p.label);
const nearSentence =
  near.length > 1 ? `${near.slice(0, -1).join(', ')} and ${near[near.length - 1]}` : near[0] ?? '';
const mapLabel = `Coverage map with ${marketLabel(market)} marked among the markets Graduate Pest Control serves.`;
---
<BaseLayout
  h1={d.title}
  path={path}
  titleCore={d.metaTitleCore}
  quickAnswer={d.quickAnswer}
  description={d.metaDescription}
  pageType="city"
  breadcrumbs={marketBreadcrumbs(market)}
  faqs={d.faqs}
  serviceName="Pest Control"
  areaServed={[`${marketLabel(market)}, NY`]}
  primaryImage={d.primaryImage}
  socialImage={crewSocialImage}
  hideFooterMap
  citations={d.sources}
>
  {/* The form sits ABOVE the body, not under it.

      It used to render only inside the closing CTA, which on an area page put
      it below the whole M1 body, the service list, the map, the nearby-areas
      list and eight FAQs - thousands of words down. A reader who had decided
      by the second paragraph had nowhere to say so. The closing CTA keeps its
      phone number and buttons; the form itself moved up here, so there is
      still exactly one form on the page. */}
  <QuickInquiry
    heading={`Tell us what you are seeing in ${marketLabel(market)}`}
    id="quick-inquiry"
  />

  <aside class="expert">
    <p>
      <strong>{business.namedExpert.name}</strong> — {business.namedExpert.role},
      {' '}{business.name}. Second generation; founded {business.foundedYear} by
      {' '}{business.founder.name} ({business.founder.credential}).
    </p>
  </aside>

  <Content />

  {services.length > 0 && (
    <>
      <h2>Services in {marketLabel(market)}</h2>
      <ul>
        {services.map((s) => (
          <li>{cityPages.has(s.slug)
            ? <a href={`/pest-control/${market.slug}/${s.slug}/`}>{s.name} in {marketLabel(market)}</a>
            : <a href={`/pest-control/${s.slug}/`}>{s.name}</a>}</li>
        ))}
      </ul>
    </>
  )}

  <GoogleMap
    heading={`${marketLabel(market)} in context`}
    label={mapLabel}
    query={`${market.name}, NY`}
    zoom={12}
    caption={nearSentence
      ? `${marketLabel(market)}. The nearest markets we work in — ${nearSentence} — are listed as links below.`
      : `${marketLabel(market)}, one of the markets Graduate Pest Control works in.`}
  />

  <h2>Nearby areas we serve</h2>
  <ul>
    {siblings.map((s) => (
      <li>{s.buildable ? <a href={s.path}>{s.name}</a> : <span>{s.name}</span>}</li>
    ))}
  </ul>
  <p><a href="/locations/">All {regionLabel(market)} service areas</a></p>

  <Faq faqs={d.faqs} />
  <Cta market={marketLabel(market)} withForm={false} />
</BaseLayout>
<style>
  .expert { border-left: 3px solid var(--brand); padding: 10px 16px; background: var(--surface-alt); font-size: .95rem; }
  .expert p { margin: 0; }
</style>
