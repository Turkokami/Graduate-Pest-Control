---
/**
 * /credentials/ — the evidence file.
 *
 * WHY THIS IS A NEW PAGE RATHER THAN AN EXPANSION OF /ryan-katz/
 * -------------------------------------------------------------
 * Three reasons, in order of weight.
 *
 * 1. Entity boundaries. /ryan-katz/ is a Person page and emits pageType
 *    'person'. Half of what belongs on a credentials page is not his: the
 *    pesticide business registration is the company's, NPMA and NYPMA are
 *    company memberships, SQF is somebody else's scheme and RelyOn is a
 *    platform. Loading firm-level facts onto a person page is exactly the
 *    blur that schema.ts spends its whole length preventing.
 * 2. Length. /ryan-katz/ is already at the top of the M1 band. Adding a
 *    4,000-word dossier to it would push it well past the target ceiling and
 *    bury the biography that page exists to carry.
 * 3. Use. This is the URL a procurement officer gets sent when they ask "who
 *    am I actually hiring." That is a different intent from "tell me about the
 *    owner", and it deserves a link that can be pasted into a vendor file.
 *
 * The two pages cross-link and do not repeat each other: /ryan-katz/ is the
 * practitioner's account, this is the register and the verification route.
 *
 * Astro 7 conventions: standalone render(entry), entry keyed by id, no Astro
 * object outside the component script, every <script> explicitly closed (there
 * are none here — nothing on this page needs client JS).
 */
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Faq from '../../components/Faq.astro';
import Cta from '../../components/Cta.astro';
import {
  business,
  affiliations,
  speaking,
  verifiableRecords,
  has,
} from '../../data/business';

const entry = await getEntry('hubs', 'credentials');
if (!entry) throw new Error('[credentials] src/content/hubs/credentials.md is missing.');

const { Content } = await render(entry);
const d = entry.data;
const path = '/credentials/';

const e = business.namedExpert;
const categories = has(e.licenseCategories) ? e.licenseCategories.join(', ') : null;

/** The register renders in a deliberate order: individual first, firm second. */
const order: Record<string, number> = {
  certification: 0,
  'audit-scheme': 1,
  platform: 2,
  membership: 3,
};
/**
 * The host, for the verify button's label. Ryan asked for the certifications to
 * be buttons out to the issuing bodies, and a button saying where it lands is
 * more use than one saying "verify" — a reader deciding whether to trust a
 * claim wants to see entocert.org before they click, not after.
 */
const verifyHost = (url: string) => {
  try { return new URL(url).hostname.replace(/^www\./, ''); }
  catch { return 'the issuing body'; }
};

const register = affiliations
  .filter((a) => a.verified)
  .slice()
  .sort((a, b) => order[a.kind] - order[b.kind]);

const kindLabel: Record<string, string> = {
  certification: 'Individual certification',
  'audit-scheme': 'Audit scheme',
  platform: 'Verification platform',
  membership: 'Trade association membership',
};

const anchor = (abbr: string) => `cred-${abbr.toLowerCase()}`;
const rows = verifiableRecords();
---
<BaseLayout
  h1={d.title}
  path={path}
  titleCore={d.metaTitleCore}
  quickAnswer={d.quickAnswer}
  description={d.metaDescription}
  pageType="page"
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Credentials', path }]}
  faqs={d.faqs}
  areaServed={['New York City', 'Long Island']}
  primaryImage={d.primaryImage}
  citations={d.sources}
>
  <aside class="expert">
    <p>
      <strong>{e.name}</strong> — {e.role}, {business.name}. Second generation;
      founded {business.foundedYear} by {business.founder.name}
      {' '}({business.founder.credential}), who still works in the firm.
    </p>
  </aside>

  {/* Jump list, so a buyer landing here from a proposal can go straight to the
      item they were sent to check. In-page anchors only — no new URLs. */}
  <nav class="jump" aria-label="Credentials on this page">
    <p class="jump-label">On this page</p>
    <ul>
      {register.map((a) => (
        <li><a href={`#${anchor(a.abbr)}`}>{a.abbr}</a></li>
      ))}
      <li><a href="#teaching">Teaching</a></li>
      <li><a href="#verify">How to verify</a></li>
    </ul>
  </nav>

  <Content />

  {/* ------------------------------------------------------------------
      The register. Every field below is generated from business.ts, so a
      credential is described in exactly one place on this site and a
      PENDING value renders as an explicit note rather than as a guess.
     ------------------------------------------------------------------ */}
  <section class="register" aria-labelledby="register-heading">
    <h2 id="register-heading">The register, item by item</h2>
    <p class="intro">
      The same information as above, set out so it can be read in a column and
      dropped into a file. Each entry states what the thing required, what it
      takes to keep, what it lets us do, and what it is not.
    </p>

    {register.map((a) => (
      <article class="cred" id={anchor(a.abbr)}>
        <header>
          <h3><span class="abbr">{a.abbr}</span> {a.name}</h3>
          <p class="kind">
            {kindLabel[a.kind]}
            {has(a.heldBy) ? <> · held by {a.heldBy}</> : null}
          </p>
        </header>
        <dl>
          <dt>{a.kind === 'membership' ? 'The association' : a.kind === 'platform' ? 'The platform' : 'Issued by'}</dt>
          <dd>{a.issuer}</dd>
          <dt>What it required</dt>
          <dd>{a.requires}</dd>
          {a.maintains && (
            <>
              <dt>What it takes to keep</dt>
              <dd>{a.maintains}</dd>
            </>
          )}
          <dt>What it lets us do</dt>
          <dd>{a.enables}</dd>
          {a.boundary && (
            <>
              <dt>What it is not</dt>
              <dd>{a.boundary}</dd>
            </>
          )}
          {a.identifier !== undefined && (
            <>
              <dt>Certificate number</dt>
              <dd>
                {has(a.identifier)
                  ? a.identifier
                  : 'Not published. The number has not been supplied to us, and this site does not print identifying numbers it cannot substantiate.'}
              </dd>
            </>
          )}
        </dl>
        {a.verifyAt && (
          <p class="verify">
            <a class="verify-btn" href={a.verifyAt.url} rel="nofollow noopener" target="_blank">
              Verify at {verifyHost(a.verifyAt.url)}
              <svg width="11" height="11" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
                <path d="M4.5 1.5h6v6M10.5 1.5 5 7M8 8.5v2h-6.5V4h2"
                      fill="none" stroke="currentColor" stroke-width="1.4"
                      stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span class="sr-only"> (opens in a new tab)</span>
            </a>
            {/* The precise document stays named. A button alone would lose the
                citation, and the exact title is the checkable part. */}
            <span class="verify-what">{a.verifyAt.name}</span>
          </p>
        )}
      </article>
    ))}
  </section>

  {speaking.headline && (
    <section class="register teaching" id="teaching" aria-labelledby="teaching-heading">
      <h2 id="teaching-heading">Teaching and field instruction</h2>
      <p class="intro">{speaking.whyItCounts}</p>
      <dl>
        {speaking.engagements.map((s) => (
          <>
            <dt>{s.country}</dt>
            <dd>
              {s.body}{s.detail ? ` — ${s.detail}` : '.'}
              {has(s.year) ? <> ({s.year})</> : null}
            </dd>
          </>
        ))}
      </dl>
      <p class="note">
        Years are not published for these engagements. They have not been confirmed,
        and an approximate date presented as a fact is still an invention.
      </p>
    </section>
  )}

  {/* ------------------------------------------------------------------
      The verification table — license rows first, because those are the
      two with real published numbers behind them.
     ------------------------------------------------------------------ */}
  <section class="register verify" id="verify" aria-labelledby="verify-heading">
    <h2 id="verify-heading">Where each item is checked</h2>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">What</th>
            <th scope="col">Held by</th>
            <th scope="col">Number</th>
            <th scope="col">Checked with</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <th scope="row">{r.what}</th>
              <td>{r.heldBy}</td>
              <td class="num">{r.identifier ?? '—'}</td>
              <td>
                {r.url
                  ? <a href={r.url} rel="nofollow noopener" target="_blank">{r.where}</a>
                  : r.where}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note">
      {business.legalName} is a service-area business covering New York City and
      Long Island. {categories
        ? `Certified applicator ${e.licenseNumber} is held in categories ${categories}; category 3A, ornamentals and turf, is not held.`
        : `Category 3A, ornamentals and turf, is not held.`}
    </p>
  </section>

  <Faq faqs={d.faqs} />
  <Cta service="Credential and compliance questions" />
</BaseLayout>

<style>
  /* The verify button. Outlined in brand blue rather than filled in CTA green:
     this is a link off the site to check a claim, and it must not read as the
     page's primary action, which is still to call. */
  .verify {
    margin: 1rem 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .55rem .8rem;
  }
  .verify-btn {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    padding: .5rem .9rem;
    border: 1px solid var(--brand);
    border-radius: var(--radius);
    font-family: var(--font-ui);
    font-size: var(--t-sm);
    font-weight: 650;
    color: var(--brand);
    text-decoration: none;
    background: var(--surface);
    transition: background-color .12s ease, color .12s ease;
  }
  .verify-btn:hover,
  .verify-btn:focus-visible {
    background: var(--brand);
    color: #fff;
  }
  .verify-btn svg { flex: none; }
  .verify-what {
    font-family: var(--font-ui);
    font-size: var(--t-xs);
    line-height: 1.4;
    color: var(--ink-faint);
    max-width: 46ch;
  }

  .expert {
    border-left: 3px solid var(--brand); padding: 10px 16px;
    background: var(--surface-alt); font-size: 0.95rem;
  }
  .expert p { margin: 0; }

  .jump { margin: 1.8rem 0 0; font-family: var(--font-ui); }
  .jump-label {
    font-size: var(--t-xs); letter-spacing: .12em; text-transform: uppercase;
    color: var(--ink-faint); margin: 0 0 .5rem;
  }
  .jump ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .45rem; }
  .jump a {
    display: inline-block; padding: .3rem .7rem; font-size: var(--t-sm);
    border: 1px solid var(--line-strong); border-radius: 999px;
    color: var(--brand); text-decoration: none;
  }
  .jump a:hover { background: var(--surface-alt); }

  .register { margin: 3.2rem 0 0; }
  .register .intro { color: var(--ink-soft); max-width: 62ch; }
  .cred {
    border-top: 1px solid var(--line);
    padding: 1.4rem 0 .4rem;
    scroll-margin-top: 1rem;
  }
  .cred h3 { margin: 0 0 .2em; font-size: var(--t-lg); }
  .cred .abbr {
    display: inline-block; margin-right: .45rem; padding: .05rem .5rem;
    background: var(--petrol); color: #fff; border-radius: var(--radius);
    font-family: var(--font-ui); font-size: var(--t-sm); font-weight: 700;
    letter-spacing: .02em; vertical-align: middle;
  }
  .cred .kind {
    font-family: var(--font-ui); font-size: var(--t-xs);
    letter-spacing: .08em; text-transform: uppercase;
    color: var(--ink-faint); margin: 0 0 .9rem;
  }
  dl { margin: 0; display: grid; gap: .1rem .2rem; }
  dt {
    font-family: var(--font-ui); font-size: var(--t-xs); font-weight: 700;
    letter-spacing: .08em; text-transform: uppercase; color: var(--brand);
    margin-top: .8rem;
  }
  dd { margin: 0; color: var(--ink-soft); }
  @media (min-width: 720px) {
    dl { grid-template-columns: 12.5rem minmax(0, 1fr); gap: .35rem 1.4rem; }
    dt { margin-top: 0; }
  }

  .teaching { border-top: 4px solid var(--green); padding-top: 1.2rem; }
  .note { font-size: var(--t-sm); color: var(--ink-faint); margin-top: 1.1rem; }

  .table-wrap { overflow-x: auto; margin: 1.4rem 0 0; }
  table { border-collapse: collapse; width: 100%; font-size: var(--t-sm); font-family: var(--font-ui); }
  th, td { text-align: left; padding: .6rem .7rem; border-bottom: 1px solid var(--line); vertical-align: top; }
  thead th {
    font-size: var(--t-xs); letter-spacing: .08em; text-transform: uppercase;
    color: var(--ink-faint); border-bottom: 2px solid var(--line-strong);
  }
  tbody th { font-weight: 600; color: var(--ink); }
  td { color: var(--ink-soft); }
  .num { font-variant-numeric: tabular-nums; white-space: nowrap; color: var(--ink); font-weight: 600; }
</style>
