---
/**
 * The pest library hub.
 *
 * Part 3.1 cardinal rule: the hub is built with real content BEFORE its
 * children, never as a stub, and it is held to the same M1 depth floor as
 * everything else. The 3,000–5,000 word body lives in the `hubs` collection;
 * this route renders the grouped index of the 20 T6 profiles and then that body.
 *
 * ORDER: index first, prose second. This is the one hub where that inversion is
 * correct. A library page is somewhere people arrive at already knowing the
 * animal and wanting its page — the index is the errand, not the reading. With
 * the M1 body first the index opened at roughly 82% of a 19,000px page, so the
 * twenty links this page exists to offer sat below about 15,800px of scrolling.
 * Every other hub keeps prose-then-index, because on those the prose IS the
 * destination.
 *
 * Astro 7 conventions: `glob()` loaders, entries keyed by `entry.id`, and the
 * standalone `render(entry)` function rather than `entry.render()`.
 *
 * Layout props mirror HubPage.astro exactly so the hub set stays consistent.
 */
import { getEntry, getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Faq from '../../components/Faq.astro';
import Cta from '../../components/Cta.astro';
import FieldGallery from '../../components/FieldGallery.astro';
import { serviceBySlug, libraryOnlyGroups } from '../../data/services';
import { business } from '../../data/business';

export const prerender = true;

const entry = await getEntry('hubs', 'pest-library');
if (!entry) throw new Error('[hub] src/content/hubs/pest-library.md is missing — Part 3.1: the hub is built before the spokes.');

const { Content } = await render(entry);
const d = entry.data;
const path = '/pest-library/';

// The 20 T6 profiles, grouped by the service spoke each one hangs off.
const profiles = await getCollection('library');

/**
 * Display order for the groups — heaviest clusters first, singles last, and the
 * one group that is not a service spoke at the very end.
 *
 * August 2026: 'termite-control' was a member of this array until Ryan retired
 * the service. The profile itself stays — it is the site's identification page
 * for the question "termite or carpenter ant" — so it needed a group key that
 * is honestly NOT a service. `identification-only` is declared in
 * services.ts/libraryOnlyGroups; serviceBySlug returns undefined for it, which
 * is what suppresses the service link here and, on the profile route, the
 * breadcrumb and the "treatment is covered under…" block.
 */
const GROUP_ORDER = [
  'rodent-control',
  'ant-control',
  'cockroach-control',
  'wasp-hornet-removal',
  'wildlife-management',
  'bed-bug-treatment',
  'mosquito-management',
  'structural-exclusion',
  'identification-only',
];

const groups = GROUP_ORDER.map((parentSlug) => {
  const service = serviceBySlug(parentSlug);
  const libraryOnly = libraryOnlyGroups[parentSlug];
  const items = profiles
    .filter((p) => p.data.parentService === parentSlug)
    .sort((a, b) => a.data.title.localeCompare(b.data.title));
  return { parentSlug, service, libraryOnly, items };
}).filter((g) => g.items.length > 0);

// A group key that is neither a service nor a declared library-only group would
// render its raw slug as a heading. Fail loudly instead.
const unlabelled = groups.filter((g) => !g.service && !g.libraryOnly).map((g) => g.parentSlug);
if (unlabelled.length) {
  throw new Error(
    `[pest-library] group key(s) with no service and no libraryOnlyGroups entry: ${unlabelled.join(', ')}`
  );
}

// Nothing may be orphaned: every profile must land in a rendered group.
const grouped = groups.reduce((n, g) => n + g.items.length, 0);
if (grouped !== profiles.length) {
  const placed = new Set(groups.flatMap((g) => g.items.map((i) => i.data.slug)));
  const missing = profiles.filter((p) => !placed.has(p.data.slug)).map((p) => p.data.parentService);
  throw new Error(
    `[pest-library] ${profiles.length - grouped} profile(s) fell outside the group index — ` +
      `unlisted parentService: ${[...new Set(missing)].join(', ')}`
  );
}
---
<BaseLayout
  h1={d.title}
  path={path}
  titleCore={d.metaTitleCore}
  quickAnswer={d.quickAnswer}
  description={d.metaDescription}
  pageType="page"
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Pest Library', path }]}
  faqs={d.faqs}
  areaServed={['New York City', 'Long Island']}
  primaryImage={d.primaryImage}
  citations={d.sources}
>
  {/* <nav> rather than <section>: this is the page's primary navigation, and it
      puts the index in the landmark list a screen reader user can jump from. */}
  <nav class="idx" aria-labelledby="picker-heading">
    <h2 id="picker-heading">All {profiles.length} pest profiles</h2>
    <p class="idx-lede">
      Grouped by the service the work is done under. Each profile covers identification, behavior
      and season, risk, signs, treatment approach and prevention. The last group is the exception,
      and says why on the page itself.
    </p>

    <div class="idx-flow">
      {groups.map((g) => (
        <div class="idx-grp">
          <h3 class="idx-grp-head">
            {g.service
              ? <a href={`/pest-control/${g.service.slug}/`}>{g.service.name}</a>
              : <span>{g.libraryOnly!.label}</span>}
          </h3>
          {!g.service && g.libraryOnly && <p class="idx-note">{g.libraryOnly.note}</p>}
          <ul class="idx-list">
            {g.items.map((p) => (
              <li>
                <a href={`/pest-library/${p.data.slug}/`}>{p.data.title}</a>
                {p.data.scientificName && <em class="idx-meta">{p.data.scientificName}</em>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </nav>

  <aside class="expert">
    <p>
      <strong>{business.namedExpert.name}</strong> — {business.namedExpert.role},
      {' '}{business.name}. Second generation; founded {business.foundedYear} by
      {' '}{business.founder.name} ({business.founder.credential}).
    </p>
  </aside>

  <Content />

  <FieldGallery shots={d.gallery ?? []} heading="Reading the signs" />

  <Faq faqs={d.faqs} />
  <Cta />
</BaseLayout>
<style>
  /* The index panel itself is the shared .idx component in tokens.css — five
     surfaces render it, so it is defined once globally rather than copied into
     each page's scoped styles. Only the page-local bits stay here. */
  .expert { border-left: 3px solid var(--brand); padding: 10px 16px; background: var(--surface-alt); font-size: 0.95rem; }
  .expert p { margin: 0; }
</style>
