---
/**
 * Header — white band, logo left, nav right. Benchmarked from the current site.
 * M7: the brand logo renders on every page with alt = the business name.
 * Update on the benchmark: a real disclosure-based mobile menu rather than a
 * script-driven overlay, so it works with JS disabled.
 *
 * THE NAV STRUCTURE, AND WHY IT IS THIS ONE
 * -----------------------------------------
 * Ryan asked for "a services page hub and a pest library hub linked to in the
 * navigation bar". The services hub was already there, mislabelled: a top-level
 * item reading "Pest Control" on a pest control company's site names the
 * industry rather than the section, and it made /pest-control/ read as one
 * service among several instead of the index of all of them. The pest library —
 * 20 profiles, the identification half of the site — was reachable only from
 * the footer. That was the real gap.
 *
 * So the bar carries five items and the CTA, and two of them open:
 *
 *   Services ▾   All pest control services  → /pest-control/  (the services hub)
 *                Structural exclusion       → the core of the business, which
 *                Rodent control                the addendum says must be the
 *                                              predominant feature of the site
 *                Pest library               → /pest-library/  (the library hub)
 *                Field notes                → /blog/          (the blog hub)
 *
 *   The blog sits here for the same reason the library does: every cluster in
 *   blog.ts feeds exactly one service spoke by construction, so the reader who
 *   opens Services is the reader who wants it. It is labelled "Field notes"
 *   rather than "Blog" because that is what it is — mechanism pieces, not
 *   company news — and because "Blog" promises a cadence nobody has committed
 *   to yet.
 *   Service Areas
 *   Commercial
 *   About ▾      Ryan Katz
 *                Credentials & licences     → /credentials/
 *   Contact      + Request Consultation
 *
 * Three deliberate calls:
 *
 * 1. "Services" is the GROUP label; the link itself still reads "All pest
 *    control services". The group label is what a reader scans for and the
 *    anchor text is what a crawler reads — relabelling the item outright would
 *    have thrown away a descriptive sitewide anchor into the hub. This keeps
 *    both.
 *
 * 2. The pest library sits inside Services rather than at top level. It is the
 *    counterpart to the service spokes — every profile links up to the spoke
 *    that treats it — so the reader who opens Services to find out what we do
 *    is exactly the reader who wants it. A sixth top-level item would also have
 *    crowded the bar at the 900px breakpoint where the desktop nav appears.
 *
 * 3. Credentials sits under About rather than in the bar. A procurement officer
 *    or a co-op board looks for it under the company, not beside the services,
 *    and it is also linked from the footer credential block and from every
 *    CredentialStrip. A top-level slot would have bought nothing and cost one.
 *
 * MECHANISM
 * ---------
 * Both dropdowns are <details>/<summary>, the same disclosure primitive the
 * mobile menu already uses. That is deliberate in preference to a hover panel:
 * <summary> is focusable and toggles on Enter and Space with no ARIA of our own
 * and no script, so the nav works from the keyboard alone and with JavaScript
 * disabled. On mobile the groups nest inside the menu's own <details> as
 * sub-disclosures.
 *
 * The inline script at the bottom is enhancement only — it closes an open
 * dropdown on Escape or on a click elsewhere. Everything opens, closes and
 * navigates without it.
 *
 * Every href below is a route this build actually generates. A bad nav target
 * is a dead link on all 216 pages at once, and the crawler in verify.mjs checks
 * every one of them against dist.
 */
import { business, brandAssets } from '../data/business';

interface NavLink { href: string; label: string }
interface NavGroup { label: string; items: NavLink[] }
type NavEntry = NavLink | NavGroup;
const isGroup = (n: NavEntry): n is NavGroup => 'items' in n;

const nav: NavEntry[] = [
  {
    label: 'Services',
    items: [
      { href: '/pest-control/', label: 'All pest control services' },
      { href: '/pest-control/structural-exclusion/', label: 'Structural exclusion' },
      { href: '/pest-control/rodent-control/', label: 'Rodent control' },
      { href: '/pest-library/', label: 'Pest library' },
      { href: '/blog/', label: 'Field notes' },
    ],
  },
  { href: '/locations/', label: 'Service Areas' },
  { href: '/commercial/', label: 'Commercial' },
  {
    label: 'About',
    items: [
      { href: `/${business.namedExpert.slug}/`, label: business.namedExpert.name },
      { href: '/credentials/', label: 'Credentials & licences' },
    ],
  },
  { href: '/contact/', label: 'Contact' },
];
---
<header class="site-header">
  <div class="inner">
    <a href="/" class="logo" aria-label={`${business.name} home`}>
      <img src={brandAssets.logo.src} alt={brandAssets.logo.alt}
           width={brandAssets.logo.width} height={brandAssets.logo.height} />
    </a>

    <nav class="desktop" aria-label="Primary">
      {nav.map((n) => isGroup(n) ? (
        <details class="dd">
          <summary>
            <span>{n.label}</span>
            <svg width="10" height="7" viewBox="0 0 10 7" aria-hidden="true" focusable="false">
              <path d="M1 1.5 5 5.5 9 1.5" fill="none" stroke="currentColor" stroke-width="1.7"
                    stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          <div class="panel">
            {n.items.map((i) => <a href={i.href}>{i.label}</a>)}
          </div>
        </details>
      ) : (
        <a href={n.href}>{n.label}</a>
      ))}
      <a class="btn btn-primary nav-cta" href="/contact/" data-cta-rival>Request Consultation</a>
    </nav>

    <details class="mobile">
      <summary aria-label="Menu"><span></span><span></span><span></span></summary>
      <nav aria-label="Primary mobile">
        {nav.map((n) => isGroup(n) ? (
          <details class="sub">
            <summary>
              <span>{n.label}</span>
              <svg width="11" height="8" viewBox="0 0 10 7" aria-hidden="true" focusable="false">
                <path d="M1 1.5 5 5.5 9 1.5" fill="none" stroke="currentColor" stroke-width="1.7"
                      stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>
            <div class="subpanel">
              {n.items.map((i) => <a href={i.href}>{i.label}</a>)}
            </div>
          </details>
        ) : (
          <a href={n.href}>{n.label}</a>
        ))}
        <a class="btn btn-primary" href="/contact/">Request Consultation</a>
      </nav>
    </details>
  </div>
</header>
<script is:inline>
  /* Enhancement only — the disclosures open, close and navigate without this. */
  (function () {
    var openDetails = function () {
      return Array.prototype.slice.call(document.querySelectorAll('.site-header details[open]'));
    };
    document.addEventListener('click', function (e) {
      openDetails().forEach(function (d) {
        if (!d.contains(e.target)) d.removeAttribute('open');
      });
    });
    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      openDetails().forEach(function (d) {
        var wasInside = d.contains(document.activeElement);
        d.removeAttribute('open');
        var s = d.querySelector('summary');
        if (s && wasInside) s.focus();
      });
    });
  })();
</script>
<style>
  .site-header { background: #fff; border-bottom: 1px solid var(--line); }
  .inner {
    max-width: var(--page); margin: 0 auto; padding: 16px 20px;
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
  }
  .logo img { height: 46px; width: auto; }

  nav.desktop { display: none; align-items: center; gap: 26px; }
  nav.desktop > a,
  nav.desktop summary {
    font-family: var(--font-ui); font-size: var(--t-sm); font-weight: 600;
    color: var(--ink); text-decoration: none;
  }
  nav.desktop > a:hover { color: var(--brand); }
  .nav-cta { padding: 11px 20px; font-size: var(--t-xs); }
  .nav-cta:hover { color: #10240a; }
  @media (min-width: 900px) {
    nav.desktop { display: flex; }
    .mobile { display: none; }
  }
  @media (min-width: 900px) and (max-width: 1040px) {
    nav.desktop { gap: 18px; }
  }

  /* ---- Desktop dropdowns. <details>, so: no script, no hover trap. ---- */
  .dd { position: relative; }
  .dd > summary {
    list-style: none; cursor: pointer;
    display: inline-flex; align-items: center; gap: 6px;
  }
  .dd > summary::-webkit-details-marker { display: none; }
  .dd > summary:hover { color: var(--brand, #166c9b); }
  .dd > summary:focus-visible { outline: 2px solid var(--brand, #166c9b); outline-offset: 4px; border-radius: 2px; }
  .dd > summary svg { opacity: .7; transition: transform .15s ease; }
  .dd[open] > summary { color: var(--brand, #166c9b); }
  .dd[open] > summary svg { transform: rotate(180deg); }
  .dd .panel {
    position: absolute; top: calc(100% + 14px); left: -18px; z-index: 70;
    min-width: 246px; background: #fff;
    border: 1px solid var(--line, #dde5ea); border-top: 3px solid var(--petrol, #0f4a6a);
    border-radius: var(--radius, 4px);
    padding: 8px 0; display: flex; flex-direction: column;
    box-shadow: 0 14px 30px rgba(7, 31, 43, .13);
  }
  .dd .panel a {
    font-family: var(--font-ui, system-ui, sans-serif); font-size: var(--t-sm, .88rem); font-weight: 600;
    color: var(--ink, #1c2b33); text-decoration: none; padding: 10px 18px; line-height: 1.3;
  }
  .dd .panel a:hover { color: var(--brand, #166c9b); background: var(--surface-alt, #f4f7f9); }

  /* ---- Mobile menu, and the groups nested inside it. ---- */
  .mobile > summary {
    list-style: none; cursor: pointer; padding: 8px;
    display: flex; flex-direction: column; gap: 5px; width: 40px;
  }
  .mobile > summary::-webkit-details-marker { display: none; }
  .mobile > summary span { display: block; height: 2px; background: var(--ink); border-radius: 2px; }
  .mobile[open] > nav {
    position: absolute; left: 0; right: 0; z-index: 60;
    background: #fff; border-bottom: 1px solid var(--line);
    padding: 8px 20px 24px; display: flex; flex-direction: column;
    box-shadow: 0 12px 24px rgba(7, 31, 43, .09);
  }
  .mobile nav > a,
  .mobile .sub > summary {
    font-family: var(--font-ui); font-size: var(--t-md); color: var(--ink);
    text-decoration: none; padding: 15px 0; border-bottom: 1px solid var(--line);
  }
  .mobile .sub > summary {
    list-style: none; cursor: pointer; font-weight: 600;
    display: flex; align-items: center; justify-content: space-between; gap: 10px;
  }
  .mobile .sub > summary::-webkit-details-marker { display: none; }
  .mobile .sub > summary svg { opacity: .7; transition: transform .15s ease; }
  .mobile .sub[open] > summary svg { transform: rotate(180deg); }
  .mobile .subpanel { display: flex; flex-direction: column; padding: 6px 0 10px 14px; }
  .mobile .subpanel a {
    font-family: var(--font-ui, system-ui, sans-serif); font-size: var(--t-sm, .88rem);
    color: var(--ink-soft, #55676f); text-decoration: none; padding: 11px 0;
  }
  .mobile .subpanel a:hover { color: var(--brand, #166c9b); }
  .mobile nav .btn { margin-top: 18px; text-align: center; border-bottom: 0; }
</style>
