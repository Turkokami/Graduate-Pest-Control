---
/**
 * CredentialStrip — the credential block, generated from src/data/business.ts.
 *
 * WHERE THIS IS MEANT TO GO
 * -------------------------
 * On the pages where a buyer is deciding, and nowhere else. It is not a badge
 * row to be stamped on 211 pages; the moment it appears everywhere it stops
 * being evidence and becomes furniture.
 *
 * Currently placed on:
 *   · /contact/                      — the page a decision lands on
 *   · /compliance/*                  — regulator- and board-facing pages
 *   · /ryan-katz/                    — via HubPage's `showCredentials` prop
 *
 * Intended for adoption, not yet wired up here because those files belong to
 * other agents in this batch:
 *   · /commercial/                   — the commercial hub
 *   · /commercial/[vertical]/        — the four new vertical pages, and the
 *                                      existing nine; `variant="compact"` reads
 *                                      better under a long regulatory intro
 *   · the food, restaurant, schools and medical verticals in particular, where
 *     PCQI / HACCP / SQF are the reason the page exists
 *
 * To adopt it:
 *     import CredentialStrip from '../../components/CredentialStrip.astro';
 *     <CredentialStrip variant="compact" context="Who is actually on your site." />
 *
 * Every string below except the labels comes from business.ts. Nothing is
 * retyped, so a credential that changes there changes on every page at once,
 * and a PENDING value renders as nothing rather than as a plausible guess.
 *
 * House rules observed: no <script> (nothing here needs one), and no <img> is
 * emitted so there is no alt-text surface to lose.
 *
 * ON THE LITERAL CSS FALLBACKS BELOW
 * ---------------------------------
 * Every custom property in the stylesheet carries a literal fallback value
 * (`var(--line, #dde5ea)`). The original reason was that /contact/ was a
 * hand-rolled document that did not load tokens.css and this component rendered
 * unstyled there. That is no longer true: /contact/ was rebuilt on BaseLayout,
 * which imports tokens.css, and every consumer of this component is now on
 * BaseLayout. So the fallbacks are no longer load-bearing anywhere.
 *
 * They are kept anyway, deliberately. They cost nothing at render time and they
 * are the right defensive form for a component that can be dropped into a page
 * that has not imported the token sheet. What has changed is the reason: they
 * are insurance now, not a workaround for a specific broken page.
 */
import { business, badgeGroups, speaking, has } from '../data/business';

interface Props {
  /** 'full' prints the issuing body and the teaching line; 'compact' does not. */
  variant?: 'full' | 'compact';
  heading?: string;
  /** One page-specific line of framing, written by the adopting page. */
  context?: string;
}

const { variant = 'full', heading = 'Credentials, licenses and how to check them', context } =
  Astro.props;

const g = badgeGroups();
const e = business.namedExpert;
const full = variant === 'full';

const categories = has(e.licenseCategories) ? e.licenseCategories.join(', ') : null;
---
<aside class="credstrip" aria-labelledby="credstrip-heading">
  <h2 id="credstrip-heading">{heading}</h2>
  {context && <p class="context">{context}</p>}

  {g.certifications.length > 0 && (
    <div class="group">
      <p class="label">Certifications held by {e.name}</p>
      <ul class="items">
        {g.certifications.map((c) => (
          <li>
            <span class="abbr">{c.abbr}</span>
            <span class="full-name">{c.name}</span>
            {full && <span class="issuer">{c.issuer}</span>}
          </li>
        ))}
      </ul>
    </div>
  )}

  <div class="meta">
    {g.memberships.length > 0 && (
      <p>
        <span class="label">Member</span>
        {g.memberships.map((m, i) => (
          <>{i > 0 ? ' · ' : ' '}<abbr title={m.name}>{m.abbr}</abbr></>
        ))}
      </p>
    )}
    {g.auditSchemes.length > 0 && (
      <p>
        <span class="label">Audit scheme</span>
        {g.auditSchemes.map((a, i) => (
          <>{i > 0 ? ' · ' : ' '}<abbr title={a.name}>{a.abbr}</abbr></>
        ))}
      </p>
    )}
    {g.platforms.length > 0 && (
      <p>
        <span class="label">Compliance records verified through</span>
        {g.platforms.map((p, i) => <>{i > 0 ? ' · ' : ' '}{p.name}</>)}
      </p>
    )}
  </div>

  <p class="licenses">
    <span class="label">Licensed in New York</span>
    {business.legalName} holds pesticide business registration <strong>{business.businessRegistration}</strong>. {e.name} holds certified applicator <strong>{e.licenseNumber}</strong>{categories ? `, categories ${categories}` : ''}. Both numbers are published so they can be checked against the state register.
  </p>

  {full && speaking.headline && (
    <p class="teaching"><span class="label">Teaching</span> {speaking.summary}</p>
  )}

  <p class="more">
    <a href="/credentials/">What each credential required, and what it lets us do &rarr;</a>
  </p>
</aside>

<style>
  .credstrip {
    border: 1px solid var(--line, #dde5ea);
    border-top: 4px solid var(--petrol, #0f4a6a);
    background: var(--surface-alt, #f4f7f9);
    padding: 1.5rem 1.5rem 1.2rem;
    margin: 3rem 0;
    font-family: var(--font-ui, system-ui, sans-serif);
    font-size: var(--t-sm, 0.88rem);
    line-height: 1.6;
  }
  .credstrip h2 {
    font-family: var(--font-display, Georgia, serif);
    font-size: var(--t-lg, 1.35rem);
    color: var(--brand-deep, #0f4a6b);
    margin: 0 0 0.5rem;
    line-height: 1.2;
  }
  .context { margin: 0 0 1.1rem; color: var(--ink-soft, #55676f); max-width: 60ch; }
  .label {
    display: inline-block;
    font-size: var(--t-xs, 0.78rem);
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--ink-faint, #8a9aa3);
    margin-right: 0.4rem;
  }
  .group .label { display: block; margin: 0 0 0.6rem; }
  .items { list-style: none; margin: 0 0 1.1rem; padding: 0; display: grid; gap: 0.55rem; }
  @media (min-width: 620px) {
    .items { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.55rem 1.6rem; }
  }
  .items li {
    display: grid;
    grid-template-columns: 4.6rem minmax(0, 1fr);
    gap: 0.1rem 0.7rem;
    align-items: baseline;
    border-bottom: 1px solid var(--line, #dde5ea);
    padding-bottom: 0.5rem;
  }
  .abbr {
    grid-row: span 2;
    font-weight: 700;
    color: var(--brand, #166c9b);
    letter-spacing: 0.02em;
  }
  .full-name { color: var(--ink, #1c2b33); }
  .issuer { font-size: var(--t-xs, 0.78rem); color: var(--ink-faint, #8a9aa3); }
  .meta p, .licenses, .teaching { margin: 0 0 0.55rem; color: var(--ink-soft, #55676f); }
  .meta abbr { text-decoration: none; border-bottom: 1px dotted var(--line-strong, #c3d0d8); }
  .licenses { max-width: 68ch; }
  .licenses strong { color: var(--ink, #1c2b33); }
  .teaching { max-width: 68ch; }
  .more { margin: 1rem 0 0; }
  .more a {
    font-weight: 650;
    color: var(--brand, #166c9b);
    text-decoration: none;
  }
  .more a:hover { text-decoration: underline; }
</style>
