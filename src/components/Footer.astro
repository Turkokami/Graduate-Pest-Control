---
/**
 * Footer. Part 6.3 — boilerplate lives in components, never in page bodies.
 *
 * Q1/Q2: Graduate is a SERVICE-AREA business run from home. The street address
 * is used for GBP verification, schema and citations, and is never displayed.
 * Q6: license numbers ARE published, attached to the right entity.
 * Q9: no guarantee language anywhere — the trust substitutes are the licenses,
 * the entomologist on staff, and 1983.
 */
import { business, badgeGroups, affiliations, has, type Affiliation } from '../data/business';
import { markets } from '../data/markets';
import CoverageMap from './CoverageMap.astro';
import { coverageAltText } from '../lib/mapdata';
const g = badgeGroups();
const year = 2026;

/**
 * THE CREDENTIAL BLOCK — generated, never typed.
 *
 * What went wrong before: the block printed two hand-written lines, one for
 * certifications and one for audit schemes. When ACE was confirmed it appeared
 * (it is a certification, so it fell into a group that was already rendered),
 * but when NPMA and NYPMA were confirmed they rendered NOWHERE, because no line
 * in this file had ever been written for `kind: 'membership'`. A credential the
 * client has paid for and confirmed was invisible on 216 pages and nobody could
 * see why. The same was true of RelyOn.
 *
 * So the block is now built from badgeGroups() through a spec list, and the
 * guard below fails the build if a verified affiliation lands in a kind no line
 * renders. A future credential appears in the footer the moment it is added to
 * business.ts with verified: true, and a future KIND cannot go silently missing
 * — it stops the build instead.
 *
 * THE LINE THAT MUST NOT BLUR (Part 11, and Ryan's own instruction):
 * memberships are NOT credentials. NPMA and NYPMA are trade associations that a
 * company joins by paying dues; nobody sat an examination for either. They get
 * their own line, held by the COMPANY, labeled as membership, and they are
 * kept out of hasCredential in schema by membershipsForSchema() upstream —
 * this footer never puts them under the certifications label.
 *
 * Equally: the certifications line is Ryan's, and ACE is a certification, not a
 * degree. Arnold Katz holds the B.S. in Entomology (University of Georgia).
 * Nothing here implies Ryan holds a degree, because he does not.
 */
interface CredLine {
  key: Affiliation['kind'];
  label: string;
  /** Print the abbreviation (ACE, NPMA) or the full name (RelyOn Nutec). */
  show: 'abbr' | 'name';
  items: Affiliation[];
}
const holderOf = (items: Affiliation[]): string | null => {
  const names = [...new Set(items.map((i) => (has(i.heldBy) ? i.heldBy : null)).filter(Boolean))];
  return names.length === 1 ? (names[0] as string) : null;
};
const certHolder = holderOf(g.certifications);
const memberHolder = holderOf(g.memberships);

const CRED_LINES: CredLine[] = [
  {
    key: 'certification',
    label: certHolder ? `Certifications held by ${certHolder}` : 'Certifications',
    show: 'abbr',
    items: g.certifications,
  },
  {
    key: 'audit-scheme',
    label: g.auditSchemes.length === 1 ? 'Audit scheme' : 'Audit schemes',
    show: 'abbr',
    items: g.auditSchemes,
  },
  {
    key: 'membership',
    label: memberHolder ? `Association memberships held by ${memberHolder}` : 'Association memberships',
    show: 'abbr',
    items: g.memberships,
  },
  {
    key: 'platform',
    label: 'Compliance records verified through',
    show: 'name',
    items: g.platforms,
  },
];

// The guard. A verified affiliation whose kind no line above renders would be
// invisible sitewide — the exact defect this rewrite exists to fix. Fail loudly.
const renderedKinds = new Set(CRED_LINES.map((l) => l.key));
const unrendered = affiliations.filter((a) => a.verified && !renderedKinds.has(a.kind));
if (unrendered.length) {
  throw new Error(
    `[footer] verified affiliation(s) of a kind the footer does not render: ` +
      `${unrendered.map((a) => `${a.abbr} (${a.kind})`).join(', ')}. Add a line for that ` +
      `kind to CRED_LINES in src/components/Footer.astro — a confirmed credential must ` +
      `never be invisible on the site.`
  );
}
const credLines = CRED_LINES.filter((l) => l.items.length > 0);

/**
 * The footer map is a COVERAGE map, not an office map — the same thing Google
 * itself shows for a service-area business. It marks East Northport at
 * locality level, alongside the other 48 markets, on a frame 85 km wide. There
 * is no pin on a building and no address text anywhere near it, because the
 * street address is never displayed on this site (Q1/Q2).
 *
 * It is static inline SVG: no script, no tile request, no API key, nothing
 * third-party on 211 pages. The reasoning is written out in CoverageMap.astro.
 * The coverage is also stated in words beside it, so the map is never the only
 * place a reader or a crawler can find out where Graduate works.
 */
const coverageCount = markets.length;
const coverageLabel = coverageAltText();

/**
 * The copyright line used to read "© 2026 Graduate Pest Control, Inc.. All
 * rights reserved." — the legal name already ends in the abbreviation's full
 * stop and the template added a second one. It renders in the footer of all 216
 * pages, so it was in every screenshot of the site anyone has ever taken.
 * Punctuate off the value rather than assuming it.
 */
const legalSentence = /[.!?]$/.test(business.legalName)
  ? business.legalName
  : `${business.legalName}.`;
---
<footer class="site-footer">
  <div class="coverage-band">
    <div class="map-frame">
      <CoverageMap
        variant="compact"
        label={coverageLabel}
        description="Long Island and New York City, with the markets Graduate Pest Control works in marked. Every area is listed as text in the service-area pages."
        showBase={true}
      />
    </div>
    <div class="coverage-copy">
      <h2>Service area</h2>
      <p>
        {business.name} works across {coverageCount} markets on Long Island and in New York City —
        Nassau and Suffolk from the North Shore down, and Manhattan, Brooklyn and Queens.
      </p>
      <p class="coverage-links">
        <a href="/locations/">Every area we serve</a>
        <a href="/locations/long-island/">Long Island</a>
        <a href="/locations/nyc/">New York City</a>
      </p>
    </div>
  </div>

  <div class="cols">
    <div class="brand-col">
      <p class="name">{business.legalName}</p>
      <p><a class="tel" href={`tel:${business.phoneE164}`}>{business.phone}</a></p>
      <p><a href={`mailto:${business.email}`}>{business.email}</a></p>
      <p class="muted">Serving New York City &amp; Long Island since {business.foundedYear}.</p>
    </div>
    <div>
      <h2>Services</h2>
      <a href="/pest-control/">All pest control services</a>
      <a href="/pest-control/structural-exclusion/">Structural exclusion</a>
      <a href="/pest-control/rodent-control/">Rodent control</a>
      <a href="/pest-library/">Pest library</a>
      <a href="/blog/">Blog</a>
      <a href="/commercial/">Commercial &amp; compliance</a>
    </div>
    <div>
      <h2>Coverage</h2>
      <a href="/locations/">All service areas</a>
      <a href="/locations/long-island/">Long Island</a>
      <a href="/locations/nyc/">New York City</a>
    </div>
    <div>
      <h2>Company</h2>
      <a href={`/${business.namedExpert.slug}/`}>{business.namedExpert.name}</a>
      <a href="/credentials/">Credentials &amp; licenses</a>
      <a href="/contact/">Contact</a>
      <a href="/compliance/choosing-a-pest-control-contractor/">Verifying a contractor</a>
    </div>
  </div>

  {credLines.length > 0 && (
    <div class="creds">
      {credLines.map((l) => (
        <p>
          <strong>{l.label}:</strong>{' '}
          {l.items.map((c, i) => (
            <>{i > 0 ? ' · ' : ''}{l.show === 'abbr'
              ? <abbr title={c.name}>{c.abbr}</abbr>
              : <span>{c.name}</span>}</>
          ))}
        </p>
      ))}
      <p class="creds-note">
        Association memberships are company affiliations, not certifications.
        {' '}<a href="/credentials/">What each credential required, and where to check it</a>.
      </p>
    </div>
  )}

  <p class="licenses">
    {business.legalName} — New York pesticide business registration {business.businessRegistration}.
    {' '}Ryan Katz, New York certified applicator {business.namedExpert.licenseNumber}{has(business.namedExpert.licenseCategories) ? `, categories ${business.namedExpert.licenseCategories.join(', ')}` : ''}.
  </p>
  <p class="legal">&copy; {year} {legalSentence} All rights reserved.</p>
</footer>
<style>
  .site-footer {
    border-top: 4px solid var(--petrol); margin-top: 4.5rem;
    padding: 3rem 20px 2.4rem; background: var(--surface-alt);
    font-family: var(--font-ui); font-size: var(--t-sm);
  }

  .coverage-band {
    max-width: var(--page); margin: 0 auto 2.6rem;
    display: grid; gap: 1.4rem 2rem; align-items: center;
    grid-template-columns: minmax(0, 1fr);
    padding-bottom: 2.4rem; border-bottom: 1px solid var(--line);
  }
  @media (min-width: 720px) {
    .coverage-band { grid-template-columns: minmax(0, 400px) minmax(0, 1fr); }
  }
  .map-frame {
    border-radius: var(--radius); overflow: hidden;
    box-shadow: 0 1px 0 var(--line-strong);
  }
  .coverage-copy h2 {
    font-family: var(--font-ui); font-size: var(--t-xs); letter-spacing: .13em;
    text-transform: uppercase; color: var(--ink-faint); margin: 0 0 .7rem;
  }
  .coverage-copy p { margin: 0 0 .8rem; color: var(--ink-soft); max-width: 46ch; }
  .coverage-links { display: flex; flex-wrap: wrap; gap: .35rem 1.1rem; margin: 0; }
  .coverage-links a { color: var(--brand); text-decoration: none; font-weight: 600; }
  .coverage-links a:hover { text-decoration: underline; }
  .cols {
    max-width: var(--page); margin: 0 auto;
    display: grid; gap: 2rem; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
  }
  .cols h2 {
    font-family: var(--font-ui); font-size: var(--t-xs); letter-spacing: .13em;
    text-transform: uppercase; color: var(--ink-faint); margin: 0 0 .9rem;
  }
  .cols a { display: block; color: var(--ink-soft); text-decoration: none; margin-bottom: .5rem; }
  .cols a:hover { color: var(--brand); }
  .brand-col p { margin: 0 0 .45rem; }
  .name { font-family: var(--font-display); font-size: var(--t-lg); color: var(--brand-deep); font-weight: 600; }
  .tel { font-weight: 700; color: var(--brand) !important; }
  .muted { color: var(--ink-faint); margin-top: .8rem !important; }
  .creds, .licenses, .legal {
    max-width: var(--page); margin: 1.6rem auto 0;
    color: var(--ink-faint); font-size: var(--t-xs); line-height: 1.65;
  }
  .creds p { margin: 0 0 .25rem; }
  .creds abbr { text-decoration: none; border-bottom: 1px dotted var(--line-strong, #c3d0d8); cursor: help; }
  .creds-note { margin-top: .55rem !important; }
  .creds-note a { color: var(--brand, #166c9b); text-decoration: none; font-weight: 600; }
  .creds-note a:hover { text-decoration: underline; }
  .licenses { border-top: 1px solid var(--line); padding-top: 1.1rem; }
  .legal { margin-top: .5rem; }
</style>
