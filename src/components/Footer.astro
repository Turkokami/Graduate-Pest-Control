---
/**
 * Footer. Part 6.3 — boilerplate lives in components, never in page bodies.
 *
 * Q1/Q2: Graduate is a SERVICE-AREA business run from home. The street address
 * is used for GBP verification, schema and citations, and is never displayed.
 * Q6: licence numbers ARE published, attached to the right entity.
 * Q9: no guarantee language anywhere — the trust substitutes are the licences,
 * the entomologist on staff, and 1983.
 */
import { business, badgeGroups, has } from '../data/business';
const g = badgeGroups();
const year = 2026;
---
<footer class="site-footer">
  <div class="cols">
    <div class="brand-col">
      <p class="name">{business.legalName}</p>
      <p><a class="tel" href={`tel:${business.phoneE164}`}>{business.phone}</a></p>
      <p><a href={`mailto:${business.email}`}>{business.email}</a></p>
      <p class="muted">Serving New York City &amp; Long Island since {business.foundedYear}.</p>
    </div>
    <div>
      <h2>Services</h2>
      <a href="/pest-control/">All pest control services</a>
      <a href="/pest-control/structural-exclusion/">Structural exclusion</a>
      <a href="/pest-control/rodent-control/">Rodent control</a>
      <a href="/pest-library/">Pest library</a>
      <a href="/commercial/">Commercial &amp; compliance</a>
    </div>
    <div>
      <h2>Coverage</h2>
      <a href="/locations/">All service areas</a>
      <a href="/locations/long-island/">Long Island</a>
      <a href="/locations/nyc/">New York City</a>
    </div>
    <div>
      <h2>Company</h2>
      <a href={`/${business.namedExpert.slug}/`}>{business.namedExpert.name}</a>
      <a href="/contact/">Contact</a>
      <a href="/compliance/choosing-a-pest-control-contractor/">Verifying a contractor</a>
    </div>
  </div>

  {(g.certifications.length > 0 || g.auditSchemes.length > 0) && (
    <p class="creds">
      {g.certifications.length > 0 && (
        <span><strong>Certifications held by Ryan Katz:</strong> {g.certifications.map((c) => c.abbr).join(' · ')}</span>
      )}
      {g.auditSchemes.length > 0 && (
        <span><strong>Audit schemes:</strong> {g.auditSchemes.map((c) => c.abbr).join(' · ')}</span>
      )}
    </p>
  )}

  <p class="licences">
    {business.legalName} — New York pesticide business registration {business.businessRegistration}.
    {' '}Ryan Katz, New York certified applicator {business.namedExpert.licenseNumber}{has(business.namedExpert.licenseCategories) ? `, categories ${business.namedExpert.licenseCategories.join(', ')}` : ''}.
  </p>
  <p class="legal">&copy; {year} {business.legalName}. All rights reserved.</p>
</footer>
<style>
  .site-footer {
    border-top: 4px solid var(--petrol); margin-top: 4.5rem;
    padding: 3rem 20px 2.4rem; background: var(--surface-alt);
    font-family: var(--font-ui); font-size: var(--t-sm);
  }
  .cols {
    max-width: var(--page); margin: 0 auto;
    display: grid; gap: 2rem; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
  }
  .cols h2 {
    font-family: var(--font-ui); font-size: var(--t-xs); letter-spacing: .13em;
    text-transform: uppercase; color: var(--ink-faint); margin: 0 0 .9rem;
  }
  .cols a { display: block; color: var(--ink-soft); text-decoration: none; margin-bottom: .5rem; }
  .cols a:hover { color: var(--brand); }
  .brand-col p { margin: 0 0 .45rem; }
  .name { font-family: var(--font-display); font-size: var(--t-lg); color: var(--brand-deep); font-weight: 600; }
  .tel { font-weight: 700; color: var(--brand) !important; }
  .muted { color: var(--ink-faint); margin-top: .8rem !important; }
  .creds, .licences, .legal {
    max-width: var(--page); margin: 1.6rem auto 0;
    color: var(--ink-faint); font-size: var(--t-xs); line-height: 1.65;
  }
  .creds span { display: block; }
  .licences { border-top: 1px solid var(--line); padding-top: 1.1rem; }
  .legal { margin-top: .5rem; }
</style>
