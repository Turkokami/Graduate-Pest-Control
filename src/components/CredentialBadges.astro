---
/**
 * CredentialBadges.astro — the credentials as badges rather than a line of
 * text (Ryan, September 2026: "it reads like claims").
 *
 * WHY THESE ARE OUR OWN BADGES AND NOT OFFICIAL SEALS. Ryan's call, and it is
 * the right one: the SQF mark belongs to certified facilities, and TWIC and
 * HUET are federal and training-provider credentials whose marks are not ours
 * to display. Using them would be a worse error in front of exactly the food
 * safety buyers this section is aimed at. So every badge is drawn here in our
 * own blue and green, identical in shape and treatment: the credential, the
 * body that issues it underneath.
 *
 * The two association member logos (NPMA, NYPMA) ARE licensed for member use.
 * When Ryan supplies the files and their usage rules, add `logo` to the entry
 * in business.ts affiliations and the badge swaps the drawn version for the
 * real mark, in the same row and at the same size.
 */
import { affiliations } from '../data/business';

interface Props {
  heading?: string;
  note?: string;
}
const { heading = 'Credentials', note } = Astro.props;

/**
 * The issuing body, short enough to sit under a badge. Long-form issuer text
 * lives in business.ts and is what /credentials/ prints in full; these are the
 * same bodies named in it.
 */
const ISSUER: Record<string, string> = {
  PCQI: 'AIB International, under FDA FSMA',
  HACCP: 'AIB International',
  SQF: 'SQF Institute',
  TWIC: 'US Transportation Security Administration',
  HUET: 'RelyOn Nutec',
  RelyOn: 'RelyOn Nutec',
  NPMA: 'National Pest Management Association',
  NYPMA: 'New York Pest Management Association',
};

const badges = affiliations
  .filter((a) => a.verified !== false)
  .map((a) => ({
    abbr: a.abbr,
    name: a.name,
    issuer: ISSUER[a.abbr] ?? null,
    member: a.kind === 'membership',
    logo: (a as { logo?: string }).logo ?? null,
  }));
---
{badges.length > 0 && (
  <section class="badges" aria-labelledby="badges-heading">
    <h2 id="badges-heading" class="badges-head">{heading}</h2>
    {note && <p class="badges-note">{note}</p>}
    <ul class="badge-row">
      {badges.map((b) => (
        <li>
          <a href="/credentials/" class="badge" title={b.name}>
            {b.logo
              ? <img src={b.logo} alt={`${b.name} member`} width="108" height="44" loading="lazy" />
              : <span class="badge-abbr">{b.abbr}</span>}
            <span class="badge-name">{b.name}</span>
            {b.issuer && <span class="badge-issuer">{b.member ? "Member · " : ""}{b.issuer}</span>}
          </a>
        </li>
      ))}
    </ul>
  </section>
)}
<style>
  .badges { margin: 2.2rem 0; }
  .badges-head { font-size: var(--t-lg); margin: 0 0 .3em; }
  .badges-note { color: var(--ink-soft); font-size: var(--t-sm); margin: 0 0 1rem; max-width: 62ch; }
  .badge-row {
    list-style: none; padding: 0; margin: 0; display: grid; gap: 10px;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  }
  .badge {
    display: flex; flex-direction: column; align-items: center; text-align: center;
    gap: .35rem; height: 100%; padding: 14px 10px 12px; text-decoration: none;
    border: 1px solid var(--line); border-top: 3px solid var(--brand);
    border-radius: var(--radius); background: var(--surface);
    transition: border-color .15s ease, box-shadow .15s ease, transform .15s ease;
  }
  .badge:hover {
    border-color: var(--line-strong); transform: translateY(-1px);
    box-shadow: 0 2px 4px rgba(7, 31, 43, .06), 0 10px 20px rgba(7, 31, 43, .07);
  }
  .badge-abbr {
    font-family: var(--font-ui); font-weight: 800; letter-spacing: .04em;
    font-size: 1.05rem; color: var(--brand-deep);
    border-bottom: 3px solid var(--green); padding: 0 .15em .15em;
  }
  .badge-name { font-family: var(--font-ui); font-size: var(--t-xs); font-weight: 650; color: var(--ink); line-height: 1.25; }
  .badge-issuer { font-size: .72rem; line-height: 1.3; color: var(--ink-faint); }
  .badge img { display: block; height: 44px; width: auto; object-fit: contain; }
</style>
