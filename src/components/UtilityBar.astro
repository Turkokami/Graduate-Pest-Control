---
/**
 * The top utility bar — benchmarked from the current site, which puts the
 * phone and a booking CTA above everything else. It is a genuinely good
 * conversion element and the rebuild keeps it.
 *
 * Q12: "Schedule Inspection" is the right verb — the consultation is free,
 * the written proposal is not. We never say "free estimate".
 */
import { business } from '../data/business';
---
<div class="utility">
  <div class="inner">
    <a class="tel" href={`tel:${business.phoneE164}`}>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .3 1.9.6 2.8a2 2 0 0 1-.4 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.5 2.8.6a2 2 0 0 1 1.7 2Z"
          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span>{business.phone}</span>
    </a>
    <a class="cta" href="/contact/">Schedule Inspection</a>
  </div>
</div>
<style>
  .utility { background: var(--navy); }
  .inner {
    max-width: var(--page); margin: 0 auto; padding: 9px 20px;
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
  }
  .tel {
    display: inline-flex; align-items: center; gap: 9px;
    color: #fff; text-decoration: none;
    font-family: var(--font-ui); font-size: var(--t-sm); font-weight: 600;
  }
  .tel:hover { color: #fff; }
  .tel svg { flex-shrink: 0; opacity: .9; }
  .cta {
    color: var(--green); text-decoration: none;
    font-family: var(--font-ui); font-size: var(--t-xs); font-weight: 700;
    letter-spacing: .13em; text-transform: uppercase;
  }
  .cta:hover { color: #a5d155; }
  @media (max-width: 430px) {
    .tel span { font-size: var(--t-sm); }
    .cta { letter-spacing: .08em; }
  }
</style>
