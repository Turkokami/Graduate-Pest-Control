---
import QuickInquiry from './QuickInquiry.astro';
/**
 * Part 4.1 block 6 — the CTA is NAMED to the page's market, never generic.
 *
 * Q12: the consultation is free; the written proposal carries a fee that is
 * credited if the work proceeds. Ryan asked for this stated plainly rather
 * than hidden — it is why Graduate is not the cheap quote. We never say
 * "free estimate", and there is no guarantee language anywhere.
 */
import { business } from '../data/business';
interface Props {
  market?: string;
  service?: string;
  /**
   * Where the secondary button goes. Defaults to /contact/, which is right on
   * all 216 other pages. /contact/ passes '#inquiry' so its own closing CTA
   * scrolls to the form instead of reloading the page the reader is already on.
   */
  secondaryHref?: string;
  secondaryLabel?: string;
  /**
   * Render the four-field form above the call block.
   *
   * Defaults on. Ryan asked for more places to convert than the single form on
   * /contact/, and this component already sits at the foot of nearly every page
   * — so putting it here reaches the whole site without touching fifteen
   * templates. /contact/ passes false, because the full form is already up the
   * page and two forms on one page is a choice nobody wants to make.
   */
  withForm?: boolean;
}
const {
  market,
  service,
  secondaryHref = '/contact/',
  secondaryLabel = 'Schedule an inspection',
  withForm = true,
} = Astro.props;
const what = service ?? 'pest control';
const where = market ? ` in ${market}` : '';
---
{withForm && (
  <QuickInquiry
    heading={service && service !== 'pest control'
      ? `Tell us what you are seeing${where}`
      : 'Tell us what you are seeing'}
    id={`quick-inquiry${market ? '-' + market.toLowerCase().replace(/[^a-z0-9]+/g, '-') : ''}`}
  />
)}
<section class="cta-block" data-cta-rival>
  <p class="eyebrow">Talk to us</p>
  <h2>{what}{where}</h2>
  <p class="body">
    The consultation is free and most problems can be diagnosed on the phone.
    A written proposal and plan carries a service fee, and that fee comes off
    the cost of the work if you go ahead.
  </p>
  <p class="actions">
    <a class="btn btn-primary" href={`tel:${business.phoneE164}`}>Call {business.phone}</a>
    <a class="btn btn-ghost" href={secondaryHref}>{secondaryLabel}</a>
  </p>
</section>
<style>
  .cta-block {
    background: var(--petrol); color: #fff;
    padding: 2.6rem 1.9rem; border-radius: var(--radius); margin: 3.4rem 0 1rem;
  }
  .cta-block :global(h2) { color: #fff; margin: 0 0 .7em; font-size: var(--t-xl); }
  .body { color: var(--on-petrol-soft); max-width: 54ch; }
  .actions { display: flex; gap: .8rem; flex-wrap: wrap; margin: 1.6rem 0 0; }
</style>
