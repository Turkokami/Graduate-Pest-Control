---
/**
 * ReviewStrip.astro — 59 five-star Google reviews, which were nowhere on the
 * site until now (Ryan, September 2026: "that's the strongest thing we have
 * and it's invisible").
 *
 * Placement is his: home page directly under the hero, above "What we handle",
 * and the same strip on a town page using that town's reviews where they
 * exist. Three cards across on desktop, stacked on a phone.
 *
 * It renders NOTHING when data/reviews.ts is empty. A heading that says 59
 * reviews with no reviews under it is worse than no section at all, and this
 * component shipping before the text does is the likeliest way that happens.
 *
 * No aggregateRating markup — see the note in data/reviews.ts.
 */
import { reviewsFor } from '../data/reviews';
import { business, has } from '../data/business';

interface Props {
  /** Market slug, so a town page prefers its own reviews. */
  town?: string;
  /** Overrides the subline on a town page. */
  subline?: string;
}
const { town, subline } = Astro.props;
const shown = reviewsFor(town, 3);
const count = business.reportedReviews.count;
const profile = has(business.googleBusinessProfile) ? business.googleBusinessProfile : null;
---
{shown.length > 0 && (
  <section class="rev" aria-labelledby="rev-heading">
    <h2 id="rev-heading">{count} reviews. Every one of them five stars.</h2>
    <p class="rev-sub">
      {subline ?? `Long Island and New York City homeowners, co-op boards and food facilities, since ${business.foundedYear}.`}
    </p>

    <ul class="rev-grid">
      {shown.map((r) => (
        <li class="rev-card">
          <p class="rev-stars" aria-label={`${r.rating} out of 5 stars`}>
            <span aria-hidden="true">★★★★★</span>
          </p>
          <blockquote class="rev-quote"><p>{r.quote}</p></blockquote>
          <p class="rev-who">
            <span class="rev-name">{r.name}</span>
            {r.townLabel && <span class="rev-town">{r.townLabel}</span>}
          </p>
          {/* Ryan: "the responses are the part I care about most." */}
          {r.response && (
            <div class="rev-reply">
              <p class="rev-reply-by">Response from the owner</p>
              <p>{r.response}</p>
            </div>
          )}
        </li>
      ))}
    </ul>

    {profile && (
      <p class="rev-all"><a href={profile} rel="noopener" target="_blank">Read all {count} reviews on Google →</a></p>
    )}
  </section>
)}
<style>
  .rev { margin: 2rem 0 2.6rem; }
  .rev :global(h2) { margin: 0 0 .3em; font-size: var(--t-xl); }
  .rev-sub { color: var(--ink-soft); font-family: var(--font-ui); font-size: var(--t-sm); margin: 0 0 1.2rem; }
  .rev-grid {
    list-style: none; padding: 0; margin: 0; display: grid; gap: 14px;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  }
  .rev-card {
    border: 1px solid var(--line); border-top: 3px solid var(--green);
    border-radius: var(--radius); background: var(--surface);
    padding: 14px 16px 12px; display: flex; flex-direction: column; gap: .5rem;
    box-shadow: 0 1px 2px rgba(7, 31, 43, .05), 0 8px 18px rgba(7, 31, 43, .05);
  }
  .rev-stars { margin: 0; color: #e8a33d; letter-spacing: .1em; font-size: 1rem; line-height: 1; }
  .rev-quote { margin: 0; }
  .rev-quote p { margin: 0; font-size: var(--t-sm); line-height: 1.55; color: var(--ink); }
  .rev-who { margin: .2rem 0 0; font-family: var(--font-ui); font-size: var(--t-xs); color: var(--ink-faint); }
  .rev-name { font-weight: 700; color: var(--ink-soft); }
  .rev-town::before { content: " · "; }
  .rev-reply { border-top: 1px solid var(--line); padding-top: .55rem; margin-top: .1rem; }
  .rev-reply p { margin: 0; font-size: var(--t-xs); line-height: 1.5; color: var(--ink-soft); }
  .rev-reply-by { font-family: var(--font-ui); font-weight: 700; color: var(--brand) !important; margin-bottom: .2rem !important; }
  .rev-all { font-family: var(--font-ui); font-size: var(--t-sm); margin: 1rem 0 0; }
  .rev-all a { font-weight: 650; text-decoration: none; }
  .rev-all a:hover { text-decoration: underline; }
</style>
